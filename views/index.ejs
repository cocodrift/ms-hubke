    </header>


   <!-- ================= ARTICLES ================= -->
<div class="lk-stack">

  <a href="/learn" class="lk-row">
    <span class="lk-thumb">📚</span>
    <span class="lk-row-title">All articles
      <span class="lk-row-sub">Guides, ideas &amp; stories</span>
    </span>
    <span class="lk-row-icon">↗</span>
  </a>

  <% if (featuredPost) { %>

    <a href="/learn/<%= featuredPost.slug %>" class="lk-big">
      <% if (featuredPost.featuredImage) { %>
        <img src="<%= featuredPost.featuredImage %>" alt="<%= featuredPost.title %>" loading="eager" />
      <% } else { %>
        <span class="lk-big-placeholder"><%= featuredPost.category %></span>
      <% } %>
      <span class="lk-badge">↗</span>
      <span class="lk-big-text">
        <span class="lk-big-cat"><%= featuredPost.category %></span>
        <span class="lk-big-title" style="display:block"><%= featuredPost.title %></span>
        <span class="lk-big-meta" style="display:block">
          <%= featuredPost.author || "M's Hub KE" %>
          <% if (featuredPost.publishedAt) { %>
            •
            <time><%= new Date(featuredPost.publishedAt).toLocaleDateString('en-KE', { day: 'numeric', month: 'short', year: 'numeric' }) %></time>
          <% } %>
        </span>
      </span>
    </a>

  <% } %>

</div>


    <!-- ================= CATEGORIES ================= -->
    <p class="lk-label">Explore</p>

    <nav class="lk-stack" aria-label="Categories">

      <a href="/learn?category=Fitness" class="lk-row lk-row-compact">
        <span class="lk-thumb"><img src="/images/fitness.jpg" alt="" loading="lazy" /></span>
        <span class="lk-row-title">Fitness
          <span class="lk-row-sub">Training, movement &amp; healthier living</span>
        </span>
        <span class="lk-row-icon">↗</span>
      </a>

      <a href="/learn?category=Fashion" class="lk-row lk-row-compact">
        <span class="lk-thumb">👕</span>
        <span class="lk-row-title">Fashion
          <span class="lk-row-sub">Style, grooming &amp; personal expression</span>
        </span>
        <span class="lk-row-icon">↗</span>
      </a>

      <a href="/learn?category=Tech" class="lk-row lk-row-compact">
        <span class="lk-thumb">💻</span>
        <span class="lk-row-title">Tech
          <span class="lk-row-sub">Apps, gadgets, AI &amp; digital life</span>
        </span>
        <span class="lk-row-icon">↗</span>
      </a>

      <a href="/learn?category=Lifestyle" class="lk-row lk-row-compact">
        <span class="lk-thumb">🌿</span>
        <span class="lk-row-title">Lifestyle
          <span class="lk-row-sub">Ideas for work, money &amp; everyday life</span>
        </span>
        <span class="lk-row-icon">↗</span>
      </a>

      <a href="/learn?category=Travel" class="lk-row lk-row-compact">
        <span class="lk-thumb">✈️</span>
        <span class="lk-row-title">Travel
          <span class="lk-row-sub">Places, experiences &amp; adventures</span>
        </span>
        <span class="lk-row-icon">↗</span>
      </a>

    </nav>


    <!-- ================= LATEST ================= -->
    <% if (latestPosts && latestPosts.length > 0) { %>

      <p class="lk-label">The latest</p>

      <div class="lk-grid">
        <% latestPosts.forEach(post => { %>
          <a href="/learn/<%= post.slug %>" class="lk-tile">
            <span class="lk-badge lk-badge-light">↗</span>
            <span class="lk-tile-media">
              <% if (post.featuredImage) { %>
                <img src="<%= post.featuredImage %>" alt="<%= post.title %>" loading="lazy" />
              <% } else { %>
                <%= post.category %>
              <% } %>
            </span>
            <span class="lk-tile-body">
              <span class="lk-tile-title" style="display:block"><%= post.title %></span>
              <% if (post.excerpt) { %>
                <span class="lk-tile-sub" style="display:block"><%= post.excerpt %></span>
              <% } %>
            </span>
          </a>
        <% }) %>
      </div>

    <% } %>


    <!-- ================= ABOUT ================= -->
    <p class="lk-label" id="about">About</p>

    <div class="lk-card">
      <h2>Hey, I'm Mark.</h2>
      <p>
        I'm a freelance worker with a background in coding and electrical
        engineering, blending online and campus-based learning.
      </p>
      <p>
        I'm passionate about continual learning, exploring new hobbies, and
        seeking personal growth opportunities.
      </p>
      <p>
        My interests sit at the intersection of technology, creativity and
        everyday life. M's Hub KE is an extension of that curiosity — a place
        to explore ideas, share useful things and document the subjects I'm
        interested in.
      </p>
    </div>


    <!-- ================= INTERESTS ================= -->
    <p class="lk-label">What I'm into</p>

    <div class="lk-grid">

      <div class="lk-tile"><div class="lk-tile-body">
        <span class="lk-tile-num">01</span>
        <h3 class="lk-tile-title" style="margin-top:6px">Technology</h3>
        <p class="lk-tile-sub">Coding, digital tools, websites and exploring what technology can make possible.</p>
      </div></div>

      <div class="lk-tile"><div class="lk-tile-body">
        <span class="lk-tile-num">02</span>
        <h3 class="lk-tile-title" style="margin-top:6px">Learning</h3>
        <p class="lk-tile-sub">Continually developing new skills through both online and campus-based learning.</p>
      </div></div>

      <div class="lk-tile"><div class="lk-tile-body">
        <span class="lk-tile-num">03</span>
        <h3 class="lk-tile-title" style="margin-top:6px">Creativity</h3>
        <p class="lk-tile-sub">Building projects, experimenting with ideas and finding interesting ways to bring concepts to life.</p>
      </div></div>

      <div class="lk-tile"><div class="lk-tile-body">
        <span class="lk-tile-num">04</span>
        <h3 class="lk-tile-title" style="margin-top:6px">Growth</h3>
        <p class="lk-tile-sub">Exploring new hobbies, experiences and opportunities that encourage personal growth.</p>
      </div></div>

    </div>


    <!-- ================= PROJECTS ================= -->
    <p class="lk-label">Things I've built</p>

    <div class="lk-stack">

      <div class="lk-card lk-project">
        <span class="lk-project-type">Web project</span>
        <h3>MiniEats Cafe</h3>
        <p>An engaging and vibrant online presence for a café, featuring menus, events and seamless reservations designed to enhance the customer experience.</p>
        <a href="https://mini-kibanda.vercel.app/" target="_blank" rel="noopener noreferrer" class="lk-pill-btn">Visit project ↗</a>
      </div>

      <div class="lk-card lk-project">
        <span class="lk-project-type">Personal platform</span>
        <h3>M's Hub KE</h3>
        <p>A personal content and portfolio platform built around my interests, projects and ideas — now evolving into a space for articles across fitness, fashion, tech, lifestyle and travel.</p>
        <a href="https://mshubk.vercel.app/" target="_blank" rel="noopener noreferrer" class="lk-pill-btn">Visit M's Hub KE ↗</a>
      </div>

    </div>


    <!-- ================= CONNECT ================= -->
    <p class="lk-label">Let's connect</p>

    <div class="lk-stack">

      <a href="https://www.instagram.com/m.s_hubke/" target="_blank" rel="noopener noreferrer" class="lk-row lk-row-compact">
        <span class="lk-thumb">🏋️</span>
        <span class="lk-row-title">M's Hub Fitness
          <span class="lk-row-sub">Our partner on Instagram</span>
        </span>
        <span class="lk-row-icon">↗</span>
      </a>

      <a href="mailto:markmutugim@gmail.com" class="lk-row lk-row-compact">
        <span class="lk-thumb">✉️</span>
        <span class="lk-row-title">Email
          <span class="lk-row-sub">markmutugim@gmail.com</span>
        </span>
        <span class="lk-row-icon">↗</span>
      </a>

      <a href="tel:+254797054212" class="lk-row lk-row-compact">
        <span class="lk-thumb">📞</span>
        <span class="lk-row-title">Call
          <span class="lk-row-sub">+254797054212</span>
        </span>
        <span class="lk-row-icon">↗</span>
      </a>

    </div>


    <!-- ================= QR ================= -->
    <p class="lk-label">Scan &amp; connect</p>

    <div class="lk-grid">
      <div class="lk-tile lk-qr">
        <img src="/images/scan2.jpg" alt="Instagram QR code" loading="lazy" />
        <p>Instagram</p>
      </div>
      <div class="lk-tile lk-qr">
        <img src="/images/scan.jpg" alt="Social media QR code" loading="lazy" />
        <p>Connect</p>
      </div>
    </div>


    <footer class="lk-footer">
      &copy; <%= new Date().getFullYear() %> The M's Hub · Ideas, guides &amp; stories for modern life.
    </footer>

  </main>

</body>
</html>
