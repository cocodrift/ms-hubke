          <path fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M8 12.3l2.7 2.7L16 9.7"/>
        </svg>
      </div>

      <h1 class="lk-name">Mark Mutugi M.</h1>
      <p class="lk-tagline">Freelancer, Coder, Engineer &amp; Creator of M's Hub KE</p>

      <ul class="lk-socials" aria-label="Social links">
